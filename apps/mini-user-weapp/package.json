{
  "name": "mini-user-weapp",
  "version": "0.1.0",
  "private": true,
  "description": "文旅消费券 · 消费者微信小程序（Taro 3 + Vue3 脚手架）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "None"
  },
  "scripts": {
