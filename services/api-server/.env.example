PORT=3000
JWT_SECRET=ticket-economy-dev-secret-change-me
JWT_EXPIRES_IN=7d

# memory | mysql | mysql-sql
# mysql-sql: 强制 MySQL 可用，连接失败进程退出
DB_MODE=memory
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=te
MYSQL_PASSWORD=te_pass
MYSQL_DATABASE=ticket_economy

REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# memory | rabbitmq
QUEUE_MODE=memory
RABBITMQ_URL=amqp://te:te_pass@127.0.0.1:5672

# async | sync
REVIEW_MODE=async
# combined: API 进程内 OCR+AI（默认，无需 workers）
# split: 投递 ticket.upload，由 services/workers 消费
REVIEW_PIPELINE=combined
# workers 回调鉴权（与 services/workers WORKER_SECRET 一致）
WORKER_SECRET=te-worker-dev-secret

# auto_approve | auto_manual | auto_reject
AI_MOCK_MODE=auto_approve
# WeChat: mock | real (jscode2session)
WECHAT_MODE=mock
WECHAT_APPID=
WECHAT_SECRET=

# Security
# Comma-separated origins, or * / empty for reflect (dev only)
CORS_ORIGINS=
TRUST_PROXY=false

# mock | http | multimodal
AI_PROVIDER=mock
AI_OCR_URL=
AI_RISK_URL=
AI_MULTIMODAL_URL=
AI_MULTIMODAL_MODEL=mock-multimodal-v1
AI_API_KEY=

UPLOAD_DIR=./uploads
MINIO_ENABLED=true
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=te_minio
MINIO_SECRET_KEY=te_minio_pass
MINIO_BUCKET=ticket-economy
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=

