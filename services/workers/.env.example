PORT=3001

# RabbitMQ (required for ticket OCR/AI pipeline)
RABBITMQ_URL=amqp://te:te_pass@127.0.0.1:5672

# API callbacks (workers apply OCR/AI results via internal HTTP)
API_BASE_URL=http://127.0.0.1:3000
WORKER_SECRET=te-worker-dev-secret

# AI mock modes (align with api-server)
AI_PROVIDER=mock
AI_MOCK_MODE=auto_approve
AI_OCR_URL=
AI_RISK_URL=
AI_MULTIMODAL_URL=
AI_MULTIMODAL_MODEL=mock-multimodal-v1
AI_API_KEY=

# Expire scanner interval (ms). 0 = disable timer (still consumes coupon.expire.scan)
EXPIRE_SCAN_INTERVAL_MS=60000

# Max retries before nack without requeue
WORKER_MAX_RETRIES=3
